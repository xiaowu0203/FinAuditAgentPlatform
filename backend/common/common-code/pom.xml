<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.finaudit</groupId>
        <artifactId>common</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>common-code</artifactId>
    <name>common-code</name>
    <description>Web 通用能力：统一返回 R&lt;T&gt; / 全局异常 / 参数校验</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- spring-tx：全局异常处理器捕获 DuplicateKeyException（org.springframework.dao，唯一索引兜底）；
             版本由 spring-boot BOM 锁定，勿手写版本号 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <!-- 跨服务 Feign 契约（客户端 + DTO）统一放本模块，任何服务引入即可复用，无需各自写一遍；
             版本由 spring-cloud-dependencies BOM 锁定，勿手写版本号。
             optional：openfeign 仅在编译契约时使用，不透传给消费者；真正发起 Feign 调用的服务
             须显式引入 common-feign-starter（openfeign + loadbalancer + 请求头透传 + 契约扫描） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Lombok（optional：不传递依赖，仅本模块编译期生成访问器） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 测试：脱敏序列化器 / 注入检测工具 单测 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
