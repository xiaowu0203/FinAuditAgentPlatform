<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.finaudit</groupId>
        <artifactId>finaudit-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>file-service</artifactId>
    <name>file-service</name>
    <description>文件服务：仅处理二进制资源（上传/下载/预览），唯一持有对象存储抽象；不含财务业务表、不建 Agent 任务、不感知审核流程</description>

    <dependencies>
        <!-- 自研 Starter -->
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-code</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-mybatisplus-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-redis-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-trace-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-swagger-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 对象存储统一抽象（MinIO / COS），文件上传能力（本服务唯一持有，业务服务一律经 FileServiceFeign 远程调用） -->
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-oss-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Lombok（实体/DTO 简化 getter/setter） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Cloud Alibaba -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
