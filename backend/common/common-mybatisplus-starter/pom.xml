    <description>MyBatis-Plus 通用能力：分页插件（多租户 P1 补全）</description>

    <dependencies>
        <!-- 租户上下文（TenantContextHolder）来源 -->
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-code</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
