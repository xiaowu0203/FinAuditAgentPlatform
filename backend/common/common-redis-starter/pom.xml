<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.finaudit</groupId>
        <artifactId>common</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>common-redis-starter</artifactId>
    <name>common-redis-starter</name>
    <description>Redis 通用能力：RedisTemplate 配置（分布式锁 P1 补全）</description>

    <dependencies>
        <!-- common-code：统一 BizException / R（分布式锁抢锁失败抛业务异常），与 mybatisplus-starter 同模式 -->
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-code</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <!-- Redisson 分布式锁（版本由 backend/pom.xml dependencyManagement 锁定 3.47.0；
             redisson-spring-boot-starter 自动装配读取 spring.data.redis.* 前缀，与 Boot 3.5 一致） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>
</project>
