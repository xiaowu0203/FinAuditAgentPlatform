<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.finaudit</groupId>
        <artifactId>finaudit-backend</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tool-service</artifactId>
    <name>tool-service</name>
    <description>工具执行服务：工具注册表 + 执行器 + 执行日志</description>

    <dependencies>
        <!-- 自研 Starter -->
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-code</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-mybatisplus-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-redis-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-trace-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-mq-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-swagger-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-ocr-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 服务间同步调用统一能力：OpenFeign + loadbalancer（Feign 契约由 common-code 提供）；
             请求头/token 透传（租户/用户身份、traceId）由 common-feign-starter 提供 -->
        <dependency>
            <groupId>com.finaudit</groupId>
            <artifactId>common-feign-starter</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 入参 JSON Schema 强校验（P2b 工具做厚核心一环） -->
        <dependency>
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
        </dependency>

        <!-- Lombok（实体/DTO 简化 getter/setter） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Cloud Alibaba -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
