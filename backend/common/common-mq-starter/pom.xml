<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.finaudit</groupId>
        <artifactId>common</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>common-mq-starter</artifactId>
    <name>common-mq-starter</name>
    <description>RabbitMQ 事件编排契约：拓扑常量 + 消息 DTO + JSON 消息转换器 + 队列声明（agent-core / tool-service 共用）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>
        <!-- Spring Retry（P3.8 R7-8）：spring.rabbitmq.listener.simple.retry.* 的**运行时依赖**。
             spring-boot-starter-amqp 不传递它；缺失时监听容器工厂在启动期就会因找不到
             RetryInterceptor 相关类而失败（不是"重试不生效"这么温和，而是起不来），故必须显式声明。 -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
    </dependencies>
</project>
