# ===== 复制为 .env 并按需修改（.env 禁止入库）=====

# Nacos（本地已有：8848）
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_AUTH_TOKEN=

# MySQL（本地已有：3306）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=root123456

# Redis（本地已有：6379）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ（本地已有：5672/15672）
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=admin123456

# MinIO（本地已有：9000/9001）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=finaudit-file

# 模型（默认 DeepSeek）
FINAUDIT_MODEL_API_KEY=
FINAUDIT_MODEL_BASE_URL=
FINAUDIT_MODEL_NAME=deepseek-chat

# JWT（P1.4 起，网关与 tenant-service 共用，HS256 要求 ≥32 字符）
# 开发占位即可，生产必须更换并妥善保管
FINAUDIT_JWT_SECRET=finaudit-dev-secret-change-me-0123456789-ABCDEF
