# ===== 复制为 .env 并按需修改（.env 禁止入库）=====
#
# ⚠️ P3.8 R7-1 起：**带「必填」标记的键没有任何回退默认值**，缺失即服务启动失败
#    （报 "Could not resolve placeholder 'XXX'"）。
#    这样做的原因：旧版把 nacos/nacos、guest/guest、minioadmin/minioadmin123 直接写在
#    application.yml 里做回退，等于把「开发默认口令」变成了生产默认口令——
#    漏配一个环境变量不会报错，只会静默用弱口令连上去。
#    地址与端口类（HOST/PORT/ENDPOINT）仍保留本地拓扑缺省，因为它们不是凭据、且本地开发固定。
#
# 加载方式：本地开发用 IDE 的 EnvFile 插件加载本文件；容器/CI 直接注入环境变量。
#           Spring Boot 本身**不**读取 .env 文件。

# Nacos（本地已有：8848）
NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos          # 必填
NACOS_PASSWORD=nacos          # 必填
NACOS_AUTH_TOKEN=

# MySQL（本地已有：3306）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=root           # 必填

# Redis（本地已有：6379）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=               # 本机 Redis 无密码时留空即可

# RabbitMQ（本地已有：5672/15672）
# ⚠️ 与 application.yml 的旧回退值 guest/guest **不一致**，故此处不再提供回退：
#    以本文件的值为准（旧版 yml 回退 guest/guest 与这里矛盾，是本轮修掉的漂移之一）
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=admin       # 必填
RABBITMQ_PASSWORD=admin123456 # 必填

# MinIO（本地已有：9000/9001）
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin       # 必填（common-oss-starter 启动自检）
MINIO_SECRET_KEY=minioadmin123    # 必填（common-oss-starter 启动自检）
MINIO_BUCKET=finaudit-file

# 模型（默认 DeepSeek）
FINAUDIT_MODEL_API_KEY=       # 必填（缺失时模型调用直接失败）
FINAUDIT_MODEL_BASE_URL=
FINAUDIT_MODEL_NAME=deepseek-chat

# 百度 OCR（P2b，common-ocr-starter；百度智能云控制台 → 应用接入 → AK/SK）
FINAUDIT_OCR_BAIDU_API_KEY=
FINAUDIT_OCR_BAIDU_SECRET_KEY=

# JWT（P1.4 起，网关与 tenant-service 共用，HS256 要求 ≥32 字符）
# 开发占位即可，生产必须更换并妥善保管；common-jwt-starter 启动自检，短于 32 字节直接失败
FINAUDIT_JWT_SECRET=finaudit-dev-secret-change-me-0123456789-ABCDEF

# ===== P3.8 R8-2 主动通知（可选）=====
# Webhook 是否允许投递到内网/环回地址。默认 false（配置文件里就是 false，此处留空即用默认）。
# ⚠️ 仅在本地联调/自测 Webhook 时需要置 true——此时服务端会允许请求 127.0.0.1/10.x 等地址，
#    等于临时打开一个 SSRF 跳板，联调完**务必改回 false**（启动日志会打 WARN 提醒）。
FINAUDIT_NOTIFY_ALLOW_PRIVATE_ADDRESS=false

# 定时投递开关：false 时 Webhook 不再自动投递，改由验证脚本/管理端点手工触发（自测更可控）。
FINAUDIT_NOTIFY_DELIVERY_ENABLED=true